{
  "sections": {
    "section": {
      "type": "section",
      "name": "En-tête de collection",
      "blocks": {
        "title": {
          "type": "text",
          "name": "Titre",
          "settings": {
            "text": "<h1>{{ closest.collection.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h2",
            "font": "var(--font-primary--family)",
            "font_size": "",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "title"
      ],
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "gap": 24,
        "horizontal_alignment": "center",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment": "center",
        "vertical_alignment_flex_direction_column": "center",
        "section_width": "page-width",
        "background_color": "#FFFFFF",
        "padding-block-start": 56,
        "padding-block-end": 32
      }
    },
    "main": {
      "type": "main-collection",
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "horizontal",
            "filter_width": "centered",
            "enable_sorting": true,
            "enable_grid_density": true,
            "padding-block-start": 8,
            "padding-block-end": 8
          },
          "blocks": {}
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 4
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border_radius": 0
              },
              "blocks": {}
            },
            "title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "padding-block-start": 8
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "type_preset": "h6",
                "font": "var(--font-body--family)",
                "font_size": "1rem"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "card-gallery",
            "title",
            "price"
          ]
        }
      },
      "settings": {
        "layout_type": "grid",
        "product_card_size": "large",
        "mobile_product_card_size": "large",
        "enable_infinite_scroll": true,
        "products_per_page": 24,
        "product_grid_width": "centered",
        "columns_gap_horizontal": 16,
        "columns_gap_vertical": 32,
        "background_color": "#FFFFFF",
        "padding-block-start": 0,
        "padding-block-end": 96
      }
    },
