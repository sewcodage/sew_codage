                  "blocks": {
                    "i": {
                      "type": "icon",
                      "settings": {
                        "icon": "heart",
                        "width": 32
                      },
                      "blocks": {}
                    },
                    "h": {
                      "type": "text",
                      "settings": {
                        "text": "<h3>Élégance au quotidien</h3>",
                        "width": "fit-content",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "h3",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem"
                      },
                      "blocks": {}
                    },
                    "p": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Un bijou délicat qui sublime aussi bien un jean qu’une robe de soirée.</p>",
                        "width": "fit-content",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "1.25rem"
                      },
                      "blocks": {}
