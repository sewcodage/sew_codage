        "gap": 32,
        "section_width": "page-width",
        "background_color": "{{ settings.color_palette.color8 }}",
        "padding-block-start": 40,
        "padding-block-end": 40
      }
    },
    "citation": {
      "type": "section",
      "name": "t:names.pull_quote",
      "blocks": {
        "i": {
          "type": "icon",
          "settings": {
            "icon": "heart",
            "width": 32
          },
          "blocks": {}
        },
        "q": {
          "type": "text",
          "settings": {
