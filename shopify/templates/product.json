            "image_ratio": "square",
            "border_radius": 24
          },
          "blocks": {}
        },
        "txt": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "gap": 12,
            "width": "custom",
            "custom_width": 100
          },
          "blocks": {
            "h": {
              "type": "text",
              "settings": {
                "text": "<h2>Les détails font la différence</h2>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "1rem"
              },
              "blocks": {}
            },
            "p": {
              "type": "text",
              "settings": {
                "text": "<p>Trèfles ciselés de 1,3 cm, chaîne fine et chaînette de rallonge de 5 cm : il s’ajuste à tous les poignets et reste léger toute la journée.</p>",
                "width": "fit-content",
                "max_width": "narrow",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "1.25rem"
              },
              "blocks": {}
