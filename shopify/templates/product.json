                  "block_order": [
                    "i",
                    "h",
                    "p"
                  ]
                },
                "c2": {
                  "type": "group",
                  "settings": {
                    "content_direction": "column",
                    "gap": 12,
                    "horizontal_alignment_flex_direction_column": "center"
                  },
                  "blocks": {
                    "i": {
                      "type": "icon",
                      "settings": {
                        "icon": "star",
                        "width": 32
                      },
                      "blocks": {}
                    },
                    "h": {
                      "type": "text",
                      "settings": {
                        "text": "<h3>Pensé pour durer</h3>",
                        "width": "fit-content",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "h3",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem"
                      },
                      "blocks": {}
                    },
                    "p": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Acier inoxydable couleur or : une base solide, pour un bijou que l’on porte tous les jours.</p>",
                        "width": "fit-content",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "1.25rem"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "i",
                    "h",
                    "p"
                  ]
                },
                "c3": {
                  "type": "group",
                  "settings": {
                    "content_direction": "column",
                    "gap": 12,
                    "horizontal_alignment_flex_direction_column": "center"
                  },
                  "blocks": {
                    "i": {
                      "type": "icon",
                      "settings": {
                        "icon": "silhouette",
                        "width": 32
                      },
                      "blocks": {}
                    },
                    "h": {
                      "type": "text",
                      "settings": {
                        "text": "<h3>Le cadeau qui fait mouche</h3>",
                        "width": "fit-content",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "h3",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem"
                      },
                      "blocks": {}
                    },
                    "p": {
                      "type": "text",
                      "settings": {
                        "text": "<p>7 couleurs pour trouver celle qui lui ressemble.</p>",
                        "width": "fit-content",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "1.25rem"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "i",
                    "h",
                    "p"
                  ]
                }
              },
              "block_order": [
                "c1",
                "c2",
                "c3"
              ]
            }
          },
          "block_order": [
            "cols"
          ]
        }
      },
      "block_order": [
        "box"
      ],
      "settings": {
        "section_width": "page-width",
        "background_color": "{{ settings.color_palette.color8 }}",
        "padding-block-start": 48,
        "padding-block-end": 0
      }
    },
    "porte": {
      "type": "section",
      "name": "t:names.image_with_text",
      "blocks": {
        "img": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/bracelet-trefle-porte.jpg",
            "image_ratio": "square",
            "border_radius": 24
          },
          "blocks": {}
        },
        "txt": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "gap": 12,
            "width": "custom",
            "custom_width": 100
          },
          "blocks": {
            "h": {
              "type": "text",
              "settings": {
                "text": "<h2>Le trèfle, votre porte-bonheur</h2>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "1rem"
              },
              "blocks": {}
            },
            "p": {
              "type": "text",
              "settings": {
                "text": "<p>Symbole de chance depuis toujours, le trèfle se porte seul pour une touche discrète ou s’accumule avec vos autres bracelets pour un effet plus affirmé.</p>",
                "width": "fit-content",
                "max_width": "narrow",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "1.25rem"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "h",
            "p"
          ]
        }
      },
      "block_order": [
        "img",
        "txt"
      ],
      "settings": {
        "content_direction": "row",
        "vertical_on_mobile": true,
        "vertical_alignment": "center",
        "gap": 32,
        "section_width": "page-width",
        "background_color": "{{ settings.color_palette.color8 }}",
        "padding-block-start": 40,
        "padding-block-end": 40
      }
    },
    "details": {
      "type": "section",
      "name": "t:names.image_with_text",
      "blocks": {
        "img": {
          "type": "image",
          "settings": {
